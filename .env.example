# =============================================================================
# Kamerka Plus GUI — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control — it contains secrets.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values, then load it:
#   export $(grep -v '^#' .env | xargs)
#
# Or use a tool like python-dotenv / direnv to load it automatically.
# =============================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# Required for production: a long random secret string.
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production

# Set to "False" (or leave unset) in production. Set to "True" only for development.
DEBUG=False

# Comma-separated list of hostnames/IPs Django is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------

# Shodan paid-account API key (required for searches)
SHODAN_API_KEY=your_shodan_api_key_here

# NIST NVD API key — raises rate limit from 5 to 50 req/30 s (optional)
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=your_nvd_api_key_here

# ---------------------------------------------------------------------------
# Database — SQLite is used by default (no config needed for dev/single-user).
# Uncomment the DB_* variables below ONLY if you want to use PostgreSQL.
# See docs/INSTALL.md and docs/DATABASE.md for setup instructions.
# ---------------------------------------------------------------------------

# DB_NAME=kamerka
# DB_USER=kamerka
# DB_PASSWORD=change_me
# Use DB_HOST=postgres when running docker compose with --profile postgres
# DB_HOST=localhost
# DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# Optional overrides (defaults shown):
# CELERY_BROKER_URL=redis://localhost:6379
# CELERY_RESULT_BACKEND=redis://localhost:6379
# CELERY_TIMEZONE=UTC
# CELERY_WORKER_CONCURRENCY=4

# Optional task-level Celery rate limits
# KAMERKA_NMAP_RATE_LIMIT=20/m
# KAMERKA_NUCLEI_RATE_LIMIT=15/m
# KAMERKA_WAPPALYZER_RATE_LIMIT=20/m
# KAMERKA_SCREENSHOT_RATE_LIMIT=10/m
# KAMERKA_PORTSCAN_RATE_LIMIT=20/m

# ---------------------------------------------------------------------------
# External tool paths (only needed if the binaries are not on $PATH)
# ---------------------------------------------------------------------------

# KAMERKA_NAABU_BIN=naabu
# KAMERKA_NUCLEI_BIN=nuclei
# KAMERKA_WAPPALYZER_BIN=wappalyzer

# Nmap scan timeout in seconds (default: 300)
# NMAP_MAX_RUNTIME=300

# Naabu port scan defaults
# KAMERKA_NAABU_PORTS=top-100
# KAMERKA_NAABU_TIMEOUT=60
# KAMERKA_NAABU_DISCOVERY_PORTS=1-65535
# KAMERKA_NAABU_DISCOVERY_TIMEOUT=120

# Nuclei scan timeout in seconds (default: 300)
# KAMERKA_NUCLEI_TIMEOUT=300

# Redis-backed internal rate limiter caps per window
# KAMERKA_RATE_WINDOW_SECONDS=60
# KAMERKA_GLOBAL_RATE=120
# KAMERKA_DEFAULT_TOOL_RATE=30
# KAMERKA_NMAP_RATE=20
# KAMERKA_NUCLEI_RATE=15
# KAMERKA_WAPPALYZER_RATE=20
# KAMERKA_SCREENSHOT_RATE=10
# KAMERKA_PORTSCAN_RATE=20

# ---------------------------------------------------------------------------
# HTTPS / Production security (leave at 0/False for HTTP-only development)
# ---------------------------------------------------------------------------

# Enable HSTS after confirming HTTPS works correctly (recommended: 31536000 = 1 year)
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Redirect plain HTTP to HTTPS (enable only when behind a TLS terminator)
# SECURE_SSL_REDIRECT=False

# Mark session and CSRF cookies as secure (HTTPS-only)
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# ---------------------------------------------------------------------------
# 3D map (/map3d) — works without any key (OpenFreeMap via MapLibre GL JS)
# ---------------------------------------------------------------------------
# Optional: Mapbox token for enhanced city building meshes (free tier at mapbox.com)
# MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# ---------------------------------------------------------------------------
# WorldMonitor Integration
# ---------------------------------------------------------------------------

# Optional: Ollama host for AI-synthesised intelligence briefs.
# Leave unset to use the built-in extractive summariser (no GPU/model needed).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT=60

# Interval in minutes between automatic Celery Beat data layer refreshes.
# Default: 60
# LAYER_REFRESH_INTERVAL_MINUTES=60

# Maximum number of news feed entries to retain in the database.
# Oldest entries are pruned automatically.  Default: 500
# FEED_MAX_ENTRIES=500
